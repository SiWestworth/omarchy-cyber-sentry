{
  "schemaVersion": 1,
  "id": "cyber.sentry",
  "name": "Cyber Sentry",
  "version": "2.6.0",
  "author": "futuresi",
  "license": "MIT",
  "description": "Cybersecurity threat intelligence: which exploited-in-the-wild vulnerabilities affect the packages installed on this machine, with CISA KEV, CVE detail, EPSS exploit-probability scores, NVD recent CVEs, ExploitDB public exploits, NCSC-NL vendor advisories, and OSV.dev coverage for global pip/npm/cargo/go packages.",
  "homepage": "https://github.com/SiWestworth/omarchy-cyber-sentry",
  "repository": "https://github.com/SiWestworth/omarchy-cyber-sentry",
  "keywords": [
    "security",
    "threat-intel",
    "cve",
    "kev",
    "epss",
    "exploited",
    "vulnerability",
    "arch",
    "nvd",
    "exploitdb",
    "ncsc",
    "advisories",
    "osv",
    "ghsa",
    "pip",
    "npm",
    "cargo",
    "go"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Cyber Sentry",
    "description": "Threat intelligence that knows what you have installed — Arch Security Tracker advisories correlated against pacman -Q, CISA KEV, EPSS exploit-probability, NVD recent CVEs, ExploitDB public exploits, NCSC-NL vendor advisories, and OSV.dev scanning of your global pip/npm/cargo/go packages.",
    "category": "Security",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalMin": 30,
      "severityThreshold": "Medium",
      "archEnabled": true,
      "kevEnabled": true,
      "nvdEnabled": true,
      "alertsEnabled": true,
      "epssEnabled": true,
      "exploitdbEnabled": true,
      "osvEnabled": true,
      "ghsaEnabled": true,
      "needrestartEnabled": true,
      "trivyEnabled": true,
      "notifyOnAffected": true,
      "notifyOnKev": true,
      "notifyOnNvd": false,
      "notifyOnAlerts": false,
      "notifyCooldownMin": 60,
      "maxItems": 50,
      "showBadge": true,
      "showKevBadge": false,
      "kevRecentDays": 90,
      "kevAffectsMeOnly": false,
      "showTrend": true,
      "digestEnabled": true,
      "digestIntervalDays": 7,
      "dndEnabled": false,
      "dndStart": "22:00",
      "dndEnd": "07:00"
    },
    "schema": [
      {
        "key": "refreshIntervalMin",
        "type": "integer",
        "label": "Poll interval (minutes)",
        "min": 10,
        "max": 1440,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "severityThreshold",
        "type": "string",
        "label": "Lowest severity shown and notified",
        "defaultValue": "Medium"
      },
      {
        "key": "archEnabled",
        "type": "boolean",
        "label": "Watch Arch Security Tracker advisories",
        "defaultValue": true
      },
      {
        "key": "kevEnabled",
        "type": "boolean",
        "label": "Watch the CISA Known Exploited Vulnerabilities catalog",
        "defaultValue": true
      },
      {
        "key": "nvdEnabled",
        "type": "boolean",
        "label": "Watch recent High/Critical CVEs from NVD",
        "defaultValue": true
      },
      {
        "key": "alertsEnabled",
        "type": "boolean",
        "label": "Watch NCSC-NL vendor advisories",
        "defaultValue": true
      },
      {
        "key": "epssEnabled",
        "type": "boolean",
        "label": "Show EPSS exploit-probability scores",
        "defaultValue": true
      },
      {
        "key": "exploitdbEnabled",
        "type": "boolean",
        "label": "Check for public exploits on ExploitDB",
        "defaultValue": true
      },
      {
        "key": "osvEnabled",
        "type": "boolean",
        "label": "Scan global pip/npm/cargo/go packages against OSV.dev",
        "defaultValue": true
      },
      {
        "key": "ghsaEnabled",
        "type": "boolean",
        "label": "Merge GitHub Security Advisories into the Recent tab",
        "defaultValue": true
      },
      {
        "key": "needrestartEnabled",
        "type": "boolean",
        "label": "Check whether a kernel update needs a reboot (via needrestart)",
        "defaultValue": true
      },
      {
        "key": "trivyEnabled",
        "type": "boolean",
        "label": "Scan local container images for vulnerabilities (via Trivy)",
        "defaultValue": true
      },
      {
        "key": "notifyOnAffected",
        "type": "boolean",
        "label": "Notify when a new advisory affects an installed package",
        "defaultValue": true
      },
      {
        "key": "notifyOnKev",
        "type": "boolean",
        "label": "Notify when a new entry is added to the KEV catalog",
        "defaultValue": true
      },
      {
        "key": "notifyOnNvd",
        "type": "boolean",
        "label": "Notify on new High/Critical NVD CVEs",
        "defaultValue": false
      },
      {
        "key": "notifyOnAlerts",
        "type": "boolean",
        "label": "Notify on new vendor advisories",
        "defaultValue": false
      },
      {
        "key": "notifyCooldownMin",
        "type": "integer",
        "label": "Minutes before an item is re-notified",
        "min": 5,
        "max": 1440,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "maxItems",
        "type": "integer",
        "label": "Maximum list rows per tab",
        "min": 10,
        "max": 500,
        "step": 10,
        "defaultValue": 50
      },
      {
        "key": "showBadge",
        "type": "boolean",
        "label": "Show the affected-package count badge on the bar icon",
        "defaultValue": true
      },
      {
        "key": "showKevBadge",
        "type": "boolean",
        "label": "Include KEV count in the bar badge",
        "defaultValue": false
      },
      {
        "key": "kevRecentDays",
        "type": "integer",
        "label": "Show KEV entries from the last N days (0 = all)",
        "min": 0,
        "max": 365,
        "step": 7,
        "defaultValue": 90
      },
      {
        "key": "kevAffectsMeOnly",
        "type": "boolean",
        "label": "KEV tab: only show entries matching installed packages",
        "defaultValue": false
      },
      {
        "key": "showTrend",
        "type": "boolean",
        "label": "Show the exposure trend sparkline",
        "defaultValue": true
      },
      {
        "key": "digestEnabled",
        "type": "boolean",
        "label": "Send a periodic digest notification",
        "defaultValue": true
      },
      {
        "key": "digestIntervalDays",
        "type": "integer",
        "label": "Days between digest notifications",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 7
      },
      {
        "key": "dndEnabled",
        "type": "boolean",
        "label": "Enable a do-not-disturb notification schedule",
        "defaultValue": false
      },
      {
        "key": "dndStart",
        "type": "string",
        "label": "Do-not-disturb start time (HH:MM)",
        "defaultValue": "22:00"
      },
      {
        "key": "dndEnd",
        "type": "string",
        "label": "Do-not-disturb end time (HH:MM)",
        "defaultValue": "07:00"
      }
    ]
  }
}
