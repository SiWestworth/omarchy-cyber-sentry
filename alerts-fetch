#!/bin/bash

# NCSC-NL vendor advisory feed fetcher.
#
# Usage: alerts-fetch [--days N]
#
# Fetches (and TTL-caches) the NCSC-NL advisories RSS feed — official
# Dutch national CERT advisories covering Google, Microsoft, Cisco,
# Mozilla, Linux, and other major vendors. CISA's own advisory RSS is
# bot-blocked from most machines, so NCSC-NL is the working alternative.
#
# Prints {"ok":true,"source":"alerts","count":N,"checkedAt":...,"advisories":[...]}
# or {"ok":false,"error":"..."} — exiting 0 either way.

set -uo pipefail

readonly URL="https://advisories.ncsc.nl/rss/advisories"
readonly UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120.0"
readonly CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-cyber-sentry"
readonly CACHE_FILE="$CACHE_DIR/alerts-cache.xml"
readonly JSON_CACHE="$CACHE_DIR/alerts-parsed.json"
readonly TTL="${SENTRY_ALERTS_TTL:-7200}"
readonly MAX_BYTES=8388608

source "${BASH_SOURCE[0]%/*}/_sentry-lib.sh"

die() {
  "$SENTRY_BIN_JQ" -cn --arg m "$1" '{ok:false, source:"alerts", error:$m}'
  exit 0
}

DAYS=14
if [[ ${1:-} == "--days" && -n ${2:-} ]]; then
  DAYS=$2
  shift 2
fi

sentry_prepare_cache_dir "$CACHE_DIR" || die "cache directory is not safe to use"

mktmp() { sentry_mktemp "$CACHE_DIR" || die "could not create a secure temp file"; }

needs_refresh() {
  [[ -s $JSON_CACHE ]] || return 0
  local now age
  now=$("$SENTRY_BIN_DATE" +%s)
  age=$((now - $("$SENTRY_BIN_STAT" -c %Y "$JSON_CACHE" 2>/dev/null || echo 0)))
  (( age >= TTL ))
}

if [[ ${1:-} == "--force" ]] || needs_refresh; then
  tmp=$(mktmp)
  if "$SENTRY_BIN_CURL" -fsSL --max-time 25 --max-filesize "$MAX_BYTES" \
       "${SENTRY_CURL_HTTPS_ONLY[@]}" \
       -A "$UA" "$URL" -o "$tmp" 2>/dev/null; then
    if "$SENTRY_BIN_XMLLINT" --noout "$tmp" 2>/dev/null; then
      "$SENTRY_BIN_MV" -f "$tmp" "$CACHE_FILE"
    else
      "$SENTRY_BIN_RM" -f "$tmp"
    fi
  else
    "$SENTRY_BIN_RM" -f "$tmp"
  fi

  # Parse XML to JSON. The NCSC RSS has multi-line <description> blocks
  # that break field-separator approaches, so we extract each field
  # separately with xmlstarlet and zip them together with paste.
  if sentry_safe_regular_file "$CACHE_FILE"; then
    cutoff=$("$SENTRY_BIN_DATE" -u -d "$DAYS days ago" +%Y-%m-%dT%H:%M:%S 2>/dev/null || \
             "$SENTRY_BIN_DATE" -u -v-"${DAYS}"d +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "")

    titles_tmp=$(mktmp)
    links_tmp=$(mktmp)
    dates_tmp=$(mktmp)
    json_tmp=$(mktmp)

    # Extract each field into separate newline-delimited files
    "$SENTRY_BIN_XMLSTARLET" sel -t -m "//item" -v "title" -n "$CACHE_FILE" 2>/dev/null \
      | "$SENTRY_BIN_SED" 's/^  *//' > "$titles_tmp"
    "$SENTRY_BIN_XMLSTARLET" sel -t -m "//item" -v "link" -n "$CACHE_FILE" 2>/dev/null \
      | "$SENTRY_BIN_SED" 's/^  *//' > "$links_tmp"
    "$SENTRY_BIN_XMLSTARLET" sel -t -m "//item" -v "pubDate" -n "$CACHE_FILE" 2>/dev/null \
      | "$SENTRY_BIN_SED" 's/^  *//' > "$dates_tmp"

    # Combine fields: paste joins by \t, jq splits and builds JSON
    "$SENTRY_BIN_PASTE" -d$'\t' \
      "$titles_tmp" \
      "$links_tmp" \
      "$dates_tmp" | \
    while IFS=$'\t' read -r title link pubDate; do
      [[ -n $title ]] || continue

      iso_date=""
      if [[ -n $pubDate ]]; then
        iso_date=$("$SENTRY_BIN_DATE" -u -d "$pubDate" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || \
                   "$SENTRY_BIN_DATE" -u -jf "%a, %d %b %Y %H:%M:%S %z" "$pubDate" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "")
      fi

      if [[ -n $cutoff && -n $iso_date && "$iso_date" < "$cutoff" ]]; then
        continue
      fi

      printf '%s\t%s\t%s\n' \
        "$(echo "$title" | "$SENTRY_BIN_SED" 's/"/\\"/g')" \
        "$(echo "$link" | "$SENTRY_BIN_SED" 's/"/\\"/g')" \
        "$iso_date"
    done | \
    "$SENTRY_BIN_JQ" -Rc 'split("\t") | {title: .[0], link: .[1], date: .[2]}' | \
    "$SENTRY_BIN_JQ" -sc --arg checked "$("$SENTRY_BIN_DATE" -u +%FT%TZ)" \
      '{ok:true, source:"alerts", count:length, checkedAt:$checked, advisories:.}' > "$json_tmp" 2>/dev/null

    [[ -s $json_tmp ]] && "$SENTRY_BIN_MV" -f "$json_tmp" "$JSON_CACHE"
    "$SENTRY_BIN_RM" -f "$titles_tmp" "$links_tmp" "$dates_tmp" "$json_tmp"
  fi
fi

[[ -s $JSON_CACHE ]] || die "NCSC-NL advisory feed is unavailable or unparseable"
sentry_safe_regular_file "$JSON_CACHE" || die "cache file is not safe to read"

"$SENTRY_BIN_CAT" "$JSON_CACHE"
