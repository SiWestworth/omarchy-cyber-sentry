#!/bin/bash

# NIST NVD API 2.0 — recent high/critical CVE feed.
#
# Usage: nvd-fetch [--days N]
#
# Fetches CVEs published in the last N days (default 7) with CVSS v3.1/v4.0
# severity of High or Critical. Rate-limited to 5 req/30s (unauthenticated),
# which fits our 30-minute poll cadence.
#
# Prints {"ok":true,"source":"nvd","count":N,"checkedAt":...,"cves":[...]}
# or {"ok":false,"error":"..."} — exiting 0 either way.

set -uo pipefail

readonly BASE_URL="https://services.nvd.nist.gov/rest/json/cves/2.0"
readonly UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120.0"
readonly CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-cyber-sentry"
readonly CACHE_FILE="$CACHE_DIR/nvd-recent.json"
readonly TTL="${SENTRY_NVD_TTL:-3600}"
readonly MAX_RESULTS=200
readonly MAX_BYTES=8388608

source "$(dirname -- "${BASH_SOURCE[0]}")/_sentry-lib.sh"

die() {
  jq -cn --arg m "$1" '{ok:false, source:"nvd", error:$m}'
  exit 0
}

DAYS=7
if [[ ${1:-} == "--days" && -n ${2:-} ]]; then
  DAYS=$2
  shift 2
fi

sentry_prepare_cache_dir "$CACHE_DIR" || die "cache directory is not safe to use"

needs_refresh() {
  [[ -s $CACHE_FILE ]] || return 0
  local now age
  now=$(date +%s)
  age=$((now - $(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)))
  (( age >= TTL ))
}

if [[ ${1:-} == "--force" ]] || needs_refresh; then
  start_date=$(date -u -d "$DAYS days ago" +%Y-%m-%dT%H:%M:%S.000 2>/dev/null || \
               date -u -v-"${DAYS}"d +%Y-%m-%dT%H:%M:%S.000 2>/dev/null || echo "")
  end_date=$(date -u +%Y-%m-%dT%H:%M:%S.000 2>/dev/null || echo "")

  [[ -n $start_date && -n $end_date ]] || die "could not compute date range"

  tmp=$(sentry_mktemp "$CACHE_DIR") || die "could not create a secure temp file"

  # Fetch both HIGH and CRITICAL
  all_results="[]"
  for severity in HIGH CRITICAL; do
    url="${BASE_URL}?pubStartDate=${start_date}&pubEndDate=${end_date}&cvssV3Severity=${severity}&resultsPerPage=${MAX_RESULTS}"

    raw=$(curl -fsSL --max-time 30 --max-filesize "$MAX_BYTES" \
      "${SENTRY_CURL_HTTPS_ONLY[@]}" \
      -A "$UA" "$url" 2>/dev/null)

    if [[ -n $raw ]]; then
      batch=$(printf '%s' "$raw" | jq -c '
        [.vulnerabilities[]? | {
          id: .cve.id,
          published: .cve.published,
          description: ([.cve.descriptions[]? | select(.lang == "en")] | .[0].value // ""),
          severity: ((.cve.metrics.cvssMetricV31 // .cve.metrics.cvssMetricV40 // [])[0].cvssData.baseSeverity // "UNKNOWN"),
          score: ((.cve.metrics.cvssMetricV31 // .cve.metrics.cvssMetricV40 // [])[0].cvssData.baseScore // null),
          vector: ((.cve.metrics.cvssMetricV31 // .cve.metrics.cvssMetricV40 // [])[0].cvssData.vectorString // ""),
          references: ([.cve.references[]?.url // ""] | .[0:5])
        }]' 2>/dev/null)

      if [[ -n $batch ]]; then
        all_results=$(printf '%s' "$all_results" "$batch" | jq -sc '.[0] + .[1]')
      fi
    fi

    # Respect rate limit: pause 7s between severity queries
    sleep 7
  done

  # Deduplicate by CVE ID
  deduped=$(printf '%s' "$all_results" | jq -c '
    unique_by(.id) | sort_by(.published) | reverse
  ' 2>/dev/null)

  [[ -n $deduped ]] || die "NVD API returned no results"

  printf '%s' "$deduped" | jq -c --arg checked "$(date -u +%FT%TZ)" \
    '{ok:true, source:"nvd", count:length, checkedAt:$checked, cves:.}' > "$tmp" 2>/dev/null

  [[ -s $tmp ]] && mv -f "$tmp" "$CACHE_FILE"
fi

[[ -s $CACHE_FILE ]] || die "NVD cache is empty"
sentry_safe_regular_file "$CACHE_FILE" || die "cache file is not safe to read"

jq -e 'type=="object" and (.cves | type=="array")' "$CACHE_FILE" >/dev/null 2>&1 ||
  die "NVD cache contains unparseable data"

cat "$CACHE_FILE"
